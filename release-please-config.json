{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "bump-patch-for-minor-pre-major": true,
      "extra-files": [
        {
          "type": "json",
          "path": "packages/core/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/parser-typescript/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/parser-php/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/parser-python/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/parser-rust/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/server/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/cli/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
