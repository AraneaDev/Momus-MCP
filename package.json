{
  "name": "momus-mcp",
  "version": "0.0.7",
  "private": true,
  "type": "module",
  "description": "Momus-MCP — unsparing mock & test integrity auditor for coding agents",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:commits": "node scripts/verify-no-codebuff-footer.mjs",
    "version:sync": "node scripts/sync-versions.mjs",
    "version:check": "node scripts/sync-versions.mjs --check",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit-self": "tsx packages/cli/src/index.ts audit . --max-issues 0",
    "serve": "tsx packages/cli/src/index.ts serve",
    "publish": "node scripts/publish.mjs",
    "mutation": "node scripts/mutate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^14.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.0.0"
  }
}
